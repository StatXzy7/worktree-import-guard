# DISABLED: authorize, configure environment protection and review before moving into .github/workflows.
name: Publish approved 0.1.2

on:
  workflow_dispatch:
    inputs:
      approve_version:
        description: Enter 0.1.2 after approving this source for release
        required: true
        type: string

permissions:
  contents: read

concurrency:
  group: publish-0.1.2
  cancel-in-progress: false

jobs:
  build:
    if: >-
      github.event_name == 'workflow_dispatch' && github.ref == 'refs/heads/main' &&
      github.repository == 'StatXzy7/worktree-import-guard' && inputs.approve_version == '0.1.2'
    runs-on: ubuntu-latest
    outputs:
      wheel_sha: ${{ steps.hashes.outputs.wheel_sha }}
      sdist_sha: ${{ steps.hashes.outputs.sdist_sha }}
    steps:
      - uses: actions/checkout@d23441a48e516b6c34aea4fa41551a30e30af803
      - uses: actions/setup-python@ece7cb06caefa5fff74198d8649806c4678c61a1
        with:
          python-version: '3.13'
      - run: python -m pip install -e '.[dev]' twine pyyaml
      - run: ruff check .
      - run: mypy src
      - run: pytest --cov=worktree_import_guard --cov-report=term-missing
      - run: python -m build
      - run: python -m twine check --strict dist/*
      - id: hashes
        shell: bash
        run: |
          test "$(git status --porcelain | wc -l)" -eq 0
          test "$(find dist -maxdepth 1 -type f | wc -l)" -eq 2
          echo "wheel_sha=$(sha256sum dist/worktree_import_guard-0.1.2-py3-none-any.whl | cut -d ' ' -f1)" >> "$GITHUB_OUTPUT"
          echo "sdist_sha=$(sha256sum dist/worktree_import_guard-0.1.2.tar.gz | cut -d ' ' -f1)" >> "$GITHUB_OUTPUT"
      - uses: actions/upload-artifact@ea165f8d65b6e75b540449e92b4886f43607fa02
        with:
          name: release-files
          path: dist/
          if-no-files-found: error

  test-files:
    needs: build
    runs-on: ${{ matrix.os }}
    strategy:
      fail-fast: false
      matrix:
        os: [ubuntu-latest, windows-latest]
    steps:
      - uses: actions/checkout@d23441a48e516b6c34aea4fa41551a30e30af803
      - uses: actions/setup-python@ece7cb06caefa5fff74198d8649806c4678c61a1
        with:
          python-version: '3.13'
      - uses: actions/download-artifact@d3f86a106a0bac45b974a628896c90dbdf5c8093
        with:
          name: release-files
          path: dist/
      - run: python -m pip install pytest build twine pyyaml
      - name: Verify build-job file identities
        env:
          WHEEL_SHA: ${{ needs.build.outputs.wheel_sha }}
          SDIST_SHA: ${{ needs.build.outputs.sdist_sha }}
        run: python -c "import hashlib,os,pathlib; d=pathlib.Path('dist'); assert hashlib.sha256((d/'worktree_import_guard-0.1.2-py3-none-any.whl').read_bytes()).hexdigest()==os.environ['WHEEL_SHA']; assert hashlib.sha256((d/'worktree_import_guard-0.1.2.tar.gz').read_bytes()).hexdigest()==os.environ['SDIST_SHA']"
      - run: python docs/releasing/check_candidate.py --dist dist --output "${{ runner.temp }}/release-check"
      - uses: actions/upload-artifact@ea165f8d65b6e75b540449e92b4886f43607fa02
        if: always()
        with:
          name: release-check-${{ matrix.os }}
          path: |
            ${{ runner.temp }}/release-check/*.log
            ${{ runner.temp }}/release-check/*.json
            ${{ runner.temp }}/release-check/*.xml
          if-no-files-found: error

  publish:
    needs: [build, test-files]
    if: >-
      github.event_name == 'workflow_dispatch' && github.ref == 'refs/heads/main' &&
      github.repository == 'StatXzy7/worktree-import-guard' && inputs.approve_version == '0.1.2'
    runs-on: ubuntu-latest
    environment:
      name: pypi
    permissions:
      id-token: write
    steps:
      - uses: actions/download-artifact@d3f86a106a0bac45b974a628896c90dbdf5c8093
        with:
          name: release-files
          path: dist/
      - name: Verify the exact tested files before upload
        env:
          WHEEL_SHA: ${{ needs.build.outputs.wheel_sha }}
          SDIST_SHA: ${{ needs.build.outputs.sdist_sha }}
        shell: bash
        run: |
          test "$(find dist -maxdepth 1 -type f | wc -l)" -eq 2
          printf '%s  %s\n' "$WHEEL_SHA" dist/worktree_import_guard-0.1.2-py3-none-any.whl "$SDIST_SHA" dist/worktree_import_guard-0.1.2.tar.gz | sha256sum --check --strict
      - uses: pypa/gh-action-pypi-publish@dc37677b2e1c63e2034f94d8a5b11f265b73ba33
        with:
          packages-dir: dist/
